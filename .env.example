# ainews Environment Configuration
# Copy this file to .env and edit with your values
# cp .env.example .env

# =============================================================================
# FLASK APPLICATION
# =============================================================================

# Secret key for session signing and CSRF protection
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Admin dashboard password (username: admin)
# IMPORTANT: Use a hashed password for security.
# Generate with: python scripts/hash_password.py
# Example: ADMIN_PASSWORD=scrypt:32768:8:1$salt$hash...
ADMIN_PASSWORD=

# Flask configuration name (development, production, testing)
FLASK_CONFIG=production

# =============================================================================
# DATABASE
# =============================================================================

# SQLite database URL
# Default: sqlite:///instance/ainews.db (relative to project root)
# For absolute path: sqlite:////opt/ainews/instance/ainews.db
DATABASE_URL=sqlite:///instance/ainews.db

# =============================================================================
# CELERY / REDIS
# =============================================================================

# Redis connection URL for Celery task broker
# Format: redis://[:password@]host:port/db
CELERY_BROKER_URL=redis://localhost:6379/0

# Redis connection URL for Celery result backend
# Usually same as broker URL
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =============================================================================
# SMTP / EMAIL
# =============================================================================

# SMTP server hostname
SMTP_HOST=smtp.example.com

# SMTP server port (587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=user@example.com

# SMTP authentication password
SMTP_PASSWORD=smtp-password-here

# Sender email address for outgoing messages
SMTP_FROM=news@example.com

# Enable TLS for SMTP connection (recommended: true)
SMTP_USE_TLS=true

# =============================================================================
# LLM PROVIDERS
# =============================================================================

# --- Ollama (Local LLM) ---
# Model name (e.g., llama3.1, mistral, phi3)
OLLAMA_MODEL=llama3.1

# Ollama API host URL
OLLAMA_HOST=http://localhost:11434

# --- OpenAI ---
# API key for OpenAI GPT models
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Anthropic ---
# API key for Anthropic Claude models
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# =============================================================================
# NOTES
# =============================================================================

# 1. At least one LLM provider must be configured (Ollama, OpenAI, or Anthropic)
# 2. Redis must be running for Celery task processing
# 3. SMTP settings are required for newsletter delivery
# 4. Keep this file secure: chmod 600 .env
# 5. Never commit .env to version control
