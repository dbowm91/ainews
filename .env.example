# ainews Environment Configuration
# Copy this file to .env and edit with your values
# cp .env.example .env

# =============================================================================
# REQUIRED — Production startup fails without these
# =============================================================================

# Flask configuration name (development, production, testing)
# Must be "production" for production deployments
FLASK_CONFIG=production

# Secret key for session signing and CSRF protection
# Must be a 64-character hex string (32 bytes)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin dashboard password (username: admin)
# IMPORTANT: Must be a hashed password — plaintext is rejected in production.
# Generate hash with: python scripts/hash_password.py
# Example output: scrypt:32768:8:1$salt$hash...
ADMIN_PASSWORD=

# HMAC signing secret for Celery tasks (minimum 32 characters)
# Used to verify task authenticity between web and worker processes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CELERY_TASK_SECRET=

# =============================================================================
# REQUIRED — Redis must be running
# =============================================================================

# Redis connection URL for Celery task broker
# Format: redis://[:password@]host:port/db
# For TLS: rediss://[:password@]host:port/db
# Default in Docker Compose: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Redis connection URL for Celery result backend
# Default in Docker Compose: redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =============================================================================
# REQUIRED — Database
# =============================================================================

# SQLite database URL
# Production default: sqlite:///instance/prod.db
# Docker Compose default: sqlite:///app/instance/prod.db
DATABASE_URL=sqlite:///instance/ainews.db

# =============================================================================
# REQUIRED — At least one LLM provider must be enabled
# =============================================================================
# See LLM PROVIDERS section below for provider configuration.
# For a local demo, install Ollama (https://ollama.ai) and leave the defaults.

# =============================================================================
# OPTIONAL — Newsletter Delivery (skip if not using email newsletters)
# =============================================================================

# SMTP server hostname
SMTP_HOST=smtp.example.com

# SMTP server port (587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=user@example.com

# SMTP authentication password
SMTP_PASSWORD=smtp-password-here

# Sender email address for outgoing messages
SMTP_FROM=news@example.com

# Enable TLS for SMTP connection (recommended: true)
SMTP_USE_TLS=true

# =============================================================================
# OPTIONAL — Redis Authentication (only if Redis requires auth)
# =============================================================================

# Enable Redis TLS/SSL (set to "true" for rediss:// or TLS connections)
REDIS_SSL=false

# Redis password (if authentication enabled on Redis server)
REDIS_PASSWORD=

# =============================================================================
# LLM PROVIDERS — enable at least one
# =============================================================================

# --- Ollama (Local, free, recommended for demo) ---
# Install: https://ollama.ai
# Model name (e.g., llama3.1, qwen3:8b)
OLLAMA_MODEL=llama3.1

# Ollama API host URL
# Bare metal: http://localhost:11434
# Docker Compose Ollama service: http://ollama:11434
# Host Ollama from Docker: http://host.docker.internal:11434
# WARNING: localhost does NOT work inside Docker containers
OLLAMA_HOST=http://localhost:11434

# --- OpenAI ---
# API key for OpenAI GPT models (required if provider enabled in providers.yaml)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Anthropic ---
# API key for Anthropic Claude models (required if provider enabled in providers.yaml)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Additional providers (all optional, only required if enabled in providers.yaml) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
TOGETHERAI_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=
OPENCODE_API_KEY=

# NOTE: In production, enabled providers missing their API key will prevent startup.
# Disabled providers do not require API keys.

# =============================================================================
# OPTIONAL — Advanced / Operational Settings
# =============================================================================

# Webhook secret encryption key (44 base64 characters)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBHOOK_SECRET_KEY=

# Google Custom Search API (for hybrid search)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Dead letter alert threshold (default: 10)
DEAD_LETTER_ALERT_THRESHOLD=10

# Content extraction timeout in seconds (default: 30)
CONTENT_EXTRACTOR_TIMEOUT=30

# Logging format: json or text (default: json)
LOG_FORMAT=json

# Duplicate detection window in days (default: 7)
DUPLICATE_DETECTION_DAYS=7

# OTLP exporter endpoint for distributed tracing (e.g., http://localhost:4317)
# Leave empty to disable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# OPTIONAL — Safe Fetch Limits
# =============================================================================

# Maximum number of redirects to follow (default: 5)
# SAFE_FETCH_MAX_REDIRECTS=5

# Maximum response body size in bytes (default: 2000000, max: 10000000)
# SAFE_FETCH_MAX_BYTES=2000000

# Connection timeout in seconds (default: 5, max: 30)
# SAFE_FETCH_CONNECT_TIMEOUT=5

# Read timeout in seconds (default: 10, max: 60)
# SAFE_FETCH_READ_TIMEOUT=10

# Total timeout in seconds (must be >= connect + read, default: 20)
# SAFE_FETCH_TOTAL_TIMEOUT=20

# =============================================================================
# NOTES
# =============================================================================

# 1. Production requires: FLASK_CONFIG=production, SECRET_KEY, ADMIN_PASSWORD,
#    CELERY_TASK_SECRET, CELERY_BROKER_URL, CELERY_RESULT_BACKEND, DATABASE_URL,
#    and at least one enabled LLM provider with default_provider set.
# 2. Redis must be running for Celery task processing.
# 3. SMTP settings are required for newsletter delivery (not for app startup).
# 4. Keep this file secure: chmod 600 .env
# 5. Never commit .env to version control
