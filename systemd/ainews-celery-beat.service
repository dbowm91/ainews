[Unit]
Description=ainews Celery Beat Scheduler
Documentation=https://github.com/dbowm91/ainews
After=network.target redis.service
Requires=redis.service

[Service]
Type=simple
User=ainews
Group=ainews
WorkingDirectory=/opt/ainews
EnvironmentFile=/opt/ainews/.env

ExecStart=/opt/ainews/.venv/bin/celery \
    -A celery_app:celery_app \
    beat \
    -l info \
    --schedule=/opt/ainews/instance/celerybeat-schedule

Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ainews-celery-beat

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ainews/instance

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
